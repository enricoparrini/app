{
  "expo": {
    "name": "Quota",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.coparentexpenses.hn6oin",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allega scontrini alle tue spese",
        "NSDocumentsFolderUsageDescription": "Allega ricevute PDF alle tue spese"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.emergent.coparentexpenses.hn6oin",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allega scontrini alle tue spese"
        }
      ],
      "expo-document-picker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
